# Public Supabase client configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional production-only staff origin, for example operations.example.com.
# Leave blank for same-origin local development.
VITE_OPERATIONS_HOST=

# Add these when the VYBE mobile apps are published.
# Until then, public playlist pages show a truthful founding-access CTA.
VITE_IOS_APP_URL=
VITE_ANDROID_APP_URL=
VITE_APP_DEEP_LINK=

# V24.34.1 account-deletion safety controls.
# Keep false until preview counts and schema cleanup have been verified locally.
ALLOW_ACCOUNT_DELETION=false
VITE_ACCOUNT_DELETION_GRACE_DAYS=7
